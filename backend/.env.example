# Local SQLite bootstrap (no Supabase required). Cloud demo / prod: leave False.
# With LOCAL_SQLITE=True and DEMO_MODE unset, demo user is injected and writes stay enabled.
LOCAL_SQLITE=False

# Demo mode: fake user + mock OCR. Cloud + DEMO_MODE=True → read-only UI.
# Local SQLite keeps writes enabled even when DEMO_MODE=True.
DEMO_MODE=False

# Required when DEMO_MODE=True (defaults work for local SQLite bootstrap).
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
DEMO_USER_EMAIL=demo@local.fuelpytracker
