# =============================================================================
# FuelPyTracker V2 — Backend Environment Template (.env.example)
# =============================================================================
# Copia questo file in `backend/.env` per configurare l'ambiente di runtime FastAPI.
# In produzione su Render, imposta queste chiavi nella dashboard delle Environment Variables.

# -----------------------------------------------------------------------------
# 1. Modalità Operativa & Persistenza Locale (Zero-Cloud Setup)
# -----------------------------------------------------------------------------
# Se True, il backend utilizza SQLite locale (data/fuel_tracker.db) invece di PostgreSQL.
# Consigliato per sviluppo locale rapido, test e container Docker autonomi.
LOCAL_SQLITE=True

# Se True, abilita l'ambiente sandbox con utente demo pre-autenticato e mock OCR
# (qualora non sia configurata una chiave OpenAI valida).
DEMO_MODE=True

# Identificativi dell'utente demo iniettato (opzionali, validi i default se omessi)
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
DEMO_USER_EMAIL=demo@local.fuelpytracker

# -----------------------------------------------------------------------------
# 2. Database Relazionale Cloud (PostgreSQL Supabase / Neon)
# -----------------------------------------------------------------------------
# Stringa di connessione SQLAlchemy PostgreSQL (richiesta se LOCAL_SQLITE=False).
# Esempio Supabase Pooler (Transaction Mode, porta 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. Vision AI per Scansione OCR Scontrini (OpenAI GPT-4o)
# -----------------------------------------------------------------------------
# Chiave API OpenAI per estrazione automatica di data, litri ed importo dagli scontrini.
# Se non impostata o in DEMO_MODE, il sistema restituisce valori mock simulati.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 4. Autenticazione Cloud Supabase (Opzionale fuori da DEMO_MODE)
# -----------------------------------------------------------------------------
# Credenziali per il client GoTrue/Supabase Auth (login e registrazione reali).
SUPABASE_URL=
SUPABASE_KEY=

# Segreto JWT per la validazione crittografica offline dei token firmati da Supabase.
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# 5. Politiche di Sicurezza CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Origini HTTP autorizzate a effettuare richieste verso le API di FastAPI.
# - Sviluppo: "*" accetta qualsiasi porta localhost.
# - Produzione: specificare i domini del frontend separati da virgola, ad esempio:
#   CORS_ORIGINS=https://fuelpytracker.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# 6. Configurazione Rete & Server Uvicorn
# -----------------------------------------------------------------------------
# Porta di ascolto del web server (impostata automaticamente da Render o Docker).
PORT=8000
