# ESEMPIO DI CONFIGURAZIONE
# Rinomina questo file in "secrets.toml" e inserisci le tue chiavi reali.
#
# Bootstrap locale SENZA Supabase:
#   Imposta LOCAL_SQLITE=True e DEMO_MODE=True nel file `.env` — puoi omettere
#   questo file oppure lasciare i placeholder. Non usare LOCAL_SQLITE su Streamlit Cloud.

[database]
# URL PostgreSQL (Supabase Transaction Mode - porta 6543).
# Con LOCAL_SQLITE=True questo valore viene ignorato (usa data/local.db).
url = "postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

[supabase]
# Credenziali API Supabase (auth). Non necessarie in LOCAL_SQLITE + DEMO_MODE.
url = "https://[PROJECT_REF].supabase.co"
key = "......" # Inserisci qui la tua ANON KEY
redirect_url = "http://localhost:8501"

[openai]
# Chiave API per la scansione OCR degli scontrini (opzionale).
api_key = "sk-proj-..."

# Opzionale su Streamlit Cloud al posto delle env DEMO_* :
# [demo]
# enabled = true
# user_id = "00000000-0000-4000-8000-000000000001"
# user_email = "demo@local.fuelpytracker"
