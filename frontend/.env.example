# =============================================================================
# FuelPyTracker V2 — Frontend Environment Template (.env.example)
# =============================================================================
# Copia questo file in .env o .env.local per personalizzare l'ambiente di sviluppo.
# In produzione (es. Vercel o Netlify), imposta queste variabili nella dashboard del provider.

# -----------------------------------------------------------------------------
# Base URL delle REST API di FastAPI
# -----------------------------------------------------------------------------
# Opzione 1: Sviluppo Locale (Default) o Container Docker Compose
#   Lasciare /api. Le chiamate verso /api/* e /health vengono instradate in locale
#   dal reverse proxy integrato di Vite (in dev) o da Nginx (in Docker Compose).
#   VITE_API_URL=/api
#
# Opzione 2: Hosting Cloud Disaccoppiato (Frontend su Vercel/Netlify, Backend su Render)
#   Impostare l'URL assoluto del backend Render (includendo /api), ad esempio:
#   VITE_API_URL=https://fuelpytracker-backend.onrender.com/api
# -----------------------------------------------------------------------------
VITE_API_URL=/api
